{
  "name": "plain-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@plain/docs --",
    "build": "turbo run build",
    "build:lib": "turbo run build --filter=@plain/ui",
    "build:docs": "turbo run build --filter=@plain/docs",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "lint": "eslint . && npm run check:workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:workspaces": "node scripts/check-workspaces.mjs",
    "test": "node --test scripts/tests/*.test.mjs && turbo run test",
    "test:watch": "npm run test:watch --workspace=@plain/ui",
    "test:e2e": "npm run test:e2e --workspace=@plain/docs --",
    "verify:package": "npm run build:lib && npm run generate:compositions && node --experimental-strip-types scripts/verify-package.mjs",
    "pack:ui": "npm run build:lib && node scripts/pack-ui.mjs",
    "prepack": "node scripts/deny-root-pack.mjs",
    "docs:versions": "node scripts/build-docs-versions.mjs",
    "generate:compositions": "node scripts/generate-compositions.mjs",
    "generate:tokens": "npm run generate:tokens --workspace=@plain/ui",
    "generate:slots": "npm run generate:slots --workspace=@plain/ui",
    "preview": "npm run preview --workspace=@plain/docs --",
    "create:package": "node scripts/create-package.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:status": "changeset status",
    "release:publish": "npm run build && npm run check:workspaces && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "turbo": "2.11.7",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
