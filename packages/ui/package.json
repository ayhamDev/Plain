{
  "name": "@plain/ui",
  "version": "0.2.0",
  "description": "A minimal, accessible React design system for prototypes and production web apps.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/ui/index.js",
  "module": "./dist/ui/index.js",
  "types": "./dist/ui/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/ui/styles.css"
    },
    "./tokens.css": {
      "types": "./dist/tokens.css.d.ts",
      "default": "./dist/tokens.css"
    },
    "./primitives": {
      "types": "./dist/ui/primitives.d.ts",
      "import": "./dist/ui/primitives.js"
    },
    "./forms": {
      "types": "./dist/ui/forms.d.ts",
      "import": "./dist/ui/forms.js"
    },
    "./overlays": {
      "types": "./dist/ui/overlays.d.ts",
      "import": "./dist/ui/overlays.js"
    },
    "./navigation": {
      "types": "./dist/ui/navigation.d.ts",
      "import": "./dist/ui/navigation.js"
    },
    "./calendar": {
      "types": "./dist/ui/calendar.d.ts",
      "import": "./dist/ui/calendar.js"
    },
    "./command": {
      "types": "./dist/ui/command.d.ts",
      "import": "./dist/ui/command.js"
    },
    "./table": {
      "types": "./dist/ui/table.d.ts",
      "import": "./dist/ui/table.js"
    },
    "./data-table": {
      "types": "./dist/ui/data-table.d.ts",
      "import": "./dist/ui/data-table.js"
    },
    "./theme": {
      "types": "./dist/ui/theme.d.ts",
      "import": "./dist/ui/theme.js"
    },
    "./styling": {
      "types": "./dist/ui/styling.d.ts",
      "import": "./dist/ui/styling.js"
    },
    "./tokens": {
      "types": "./dist/ui/token-contract.d.ts",
      "import": "./dist/ui/token-contract.js"
    },
    "./color-theme": {
      "types": "./dist/ui/color-theme.d.ts",
      "import": "./dist/ui/color-theme.js"
    },
    "./extend": {
      "types": "./dist/ui/extend.d.ts",
      "import": "./dist/ui/extend.js"
    },
    "./motion": {
      "types": "./dist/ui/motion.d.ts",
      "import": "./dist/ui/motion.js"
    },
    "./layout": {
      "types": "./dist/ui/layout.d.ts",
      "import": "./dist/ui/layout.js"
    },
    "./virtual": {
      "types": "./dist/ui/virtual.d.ts",
      "import": "./dist/ui/virtual.js"
    },
    "./sidebar": {
      "types": "./dist/ui/sidebar.d.ts",
      "import": "./dist/ui/sidebar.js"
    },
    "./advanced": {
      "types": "./dist/ui/advanced.d.ts",
      "import": "./dist/ui/advanced.js"
    },
    "./date-time": {
      "types": "./dist/ui/date-time.d.ts",
      "import": "./dist/ui/date-time.js"
    },
    "./charts": {
      "types": "./dist/ui/charts.d.ts",
      "import": "./dist/ui/charts.js"
    },
    "./full-calendar": {
      "types": "./dist/ui/full-calendar.d.ts",
      "import": "./dist/ui/full-calendar.js"
    },
    "./typography": {
      "types": "./dist/ui/typography.d.ts",
      "import": "./dist/ui/typography.js"
    },
    "./charts.css": {
      "types": "./dist/charts.css.d.ts",
      "default": "./dist/charts-styles.css"
    },
    "./full-calendar.css": {
      "types": "./dist/full-calendar.css.d.ts",
      "default": "./dist/full-calendar-styles.css"
    },
    "./kanban": {
      "types": "./dist/ui/kanban.d.ts",
      "import": "./dist/ui/kanban.js"
    },
    "./i18n": {
      "types": "./dist/ui/i18n.d.ts",
      "import": "./dist/ui/i18n.js"
    },
    "./chips": {
      "types": "./dist/ui/chips.d.ts",
      "import": "./dist/ui/chips.js"
    },
    "./search-view": {
      "types": "./dist/ui/search-view.d.ts",
      "import": "./dist/ui/search-view.js"
    }
  },
  "scripts": {
    "generate:slots": "node scripts/generate-slots.mjs",
    "generate:tokens": "node --experimental-strip-types scripts/generate-tokens.mjs",
    "build": "npm run generate:tokens && npm run generate:slots && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@material/material-color-utilities": "^0.3.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.14.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "temporal-polyfill": "^1.0.5",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
